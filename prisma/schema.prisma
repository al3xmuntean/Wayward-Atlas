generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 4 Authenticated Roles (plus unauthenticated PUBLIC)
enum Role {
  ADMIN
  PARTNER
  CLOSE_FRIEND
  VIEWER
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  name           String
  passwordHash   String
  role           String        @default("VIEWER") // "ADMIN", "PARTNER", "CLOSE_FRIEND", "VIEWER"
  canViewPrivate Boolean       @default(false)
  comments       Comment[]
  sharedTrips    TripAccess[]
  createdAt      DateTime      @default(now())
}

model Trip {
  id                String        @id @default(uuid())
  title             String
  description       String?
  translations      String?                         // JSON string: { en: { title, description }, de: { ... }, es: { ... }, fr: { ... } }
  startDate         DateTime
  endDate           DateTime?
  isPrivate         Boolean       @default(false)
  minRole           String        @default("VIEWER") // "PUBLIC", "VIEWER", "CLOSE_FRIEND", "PARTNER", "ADMIN"
  status            String        @default("COMPLETED") // "PLANNED" | "COMPLETED"
  withPartner       Boolean       @default(false)   // Marked if traveled together with partner
  partnerNotes      String?                         // Special travel details/notes visible only to partner & admin
  latitude          Float?                          // Direct coords for planned trips before photos exist
  longitude         Float?
  planData          String?                         // JSON string: { destination, days, style, itinerary: [...], targetCheckpoints: [...] }
  achievementReport String?                         // JSON string: { score, achieved: [...], missed: [...], extra: [...], summary: "..." }
  createdById       String
  photos            Photo[]
  comments          Comment[]
  allowedUsers      TripAccess[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Photo {
  id                 String        @id @default(uuid())
  tripId             String
  trip               Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  url                String
  thumbnailUrl       String
  latitude           Float
  longitude          Float
  placeName          String?
  country            String?
  city               String?
  spotName           String?       // Specific POI / Spot name (e.g. "Turnul Sfatului", "Piața Mare")
  spotDescription    String?       // Description for the spot / POI
  caption            String?       // Photo-specific title or caption
  originalUrl        String?       // Full-resolution original photo URL for download
  takenAt            DateTime
  hasPeople          Boolean       @default(false) // If true, requires at least CLOSE_FRIEND
  isPrivate          Boolean       @default(false)
  minRole            String        @default("VIEWER") // "PUBLIC", "VIEWER", "CLOSE_FRIEND", "PARTNER", "ADMIN"
  isCountryCover     Boolean       @default(false) // Single designated showcase image for this country in Public mode
  partnerPreselected Boolean       @default(false) // Auto-detected or marked couple/partner memory
  tags               String        @default("[]") // JSON string: ["beach", "sunset", "mountain"]
  views              PhotoView[]
  createdAt          DateTime      @default(now())
}

model TripAccess {
  id        String   @id @default(uuid())
  tripId    String
  userId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  tripId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PhotoView {
  id          String   @id @default(uuid())
  photoId     String
  photo       Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  ip          String   // Visitor IP
  country     String?  // Country name (e.g. "România", "Italia")
  countryCode String?  // 2-letter ISO (e.g. "RO", "IT")
  city        String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([photoId])
  @@index([ip])
  @@index([countryCode])
  @@index([createdAt])
}

