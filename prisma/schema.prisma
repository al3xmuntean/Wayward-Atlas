generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  VIEWER
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  name           String
  passwordHash   String
  role           String        @default("USER") // "ADMIN", "USER", "VIEWER"
  canViewPrivate Boolean       @default(false)
  comments       Comment[]
  sharedTrips    TripAccess[]
  createdAt      DateTime      @default(now())
}

model Trip {
  id           String        @id @default(uuid())
  title        String
  description  String?
  startDate    DateTime
  endDate      DateTime?
  isPrivate    Boolean       @default(false)
  createdById  String
  photos       Photo[]
  comments     Comment[]
  allowedUsers TripAccess[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Photo {
  id           String        @id @default(uuid())
  tripId       String
  trip         Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  url          String
  thumbnailUrl String
  latitude     Float
  longitude    Float
  placeName    String?
  country      String?
  city         String?
  takenAt      DateTime
  hasPeople    Boolean       @default(false)
  isPrivate    Boolean       @default(false)
  tags         String        @default("[]") // JSON string: ["beach", "sunset", "mountain"]
  createdAt    DateTime      @default(now())
}

model TripAccess {
  id        String   @id @default(uuid())
  tripId    String
  userId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  tripId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
